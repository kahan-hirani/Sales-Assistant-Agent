    {
      "name": "🔧 Utilities",
      "item": [
        {
          "name": "Setup New Test User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/get?test=setup",
              "protocol": "https",
              "host": ["postman-echo", "com"],
              "path": ["get"],
              "query": [
                {
                  "key": "test",
                  "value": "setup"
                }
              ]
            },
            "description": "Utility request to initialize a new test user and session"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Generate new user ID",
                  "const timestamp = Date.now();",
                  "const newUserId = 'test_user_' + timestamp;",
                  "const sessionPrefix = 'sess_' + Math.random().toString(36).substring(2, 8);",
                  "",
                  "pm.environment.set('user_id', newUserId);",
                  "pm.environment.set('session_prefix', sessionPrefix);",
                  "pm.environment.set('custom_user_id', 'custom_' + timestamp);",
                  "",
                  "console.log('✅ New test user created:');",
                  "console.log('   User ID:', newUserId);",
                  "console.log('   Session Prefix:', sessionPrefix);",
                  "",
                  "pm.test('Environment variables set', function() {",
                  "    pm.expect(pm.environment.get('user_id')).to.exist;",
                  "    pm.expect(pm.environment.get('session_prefix')).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Clear All Environment Variables",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/get?clear=all",
              "protocol": "https",
              "host": ["postman-echo", "com"],
              "path": ["get"],
              "query": [
                {
                  "key": "clear",
                  "value": "all"
                }
              ]
            },
            "description": "Clear all dynamically created environment variables"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// List of variables to clear",
                  "const varsToClear = [",
                  "    'user_id',",
                  "    'session_id_1',",
                  "    'session_id_2',",
                  "    'custom_user_id',",
                  "    'last_response',",
                  "    'session_prefix',",
                  "    'last_health_check',",
                  "    'user_id_to_delete'",
                  "];",
                  "",
                  "varsToClear.forEach(function(varName) {",
                  "    pm.environment.unset(varName);",
                  "});",
                  "",
                  "console.log('🧹 Cleared', varsToClear.length, 'environment variables');",
                  "",
                  "pm.test('Variables cleared', function() {",
                  "    pm.expect(pm.environment.get('user_id')).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "description": "Utility requests for managing test environment and variables"
    },
    {
      "name": "🧠 Memory Summarization (Bonus)",
      "item": [
        {
          "name": "Get Summarization Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
